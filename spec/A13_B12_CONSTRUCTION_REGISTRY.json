      "spec_ids": [
        "A11-NG-ROLE-001",
        "A11-NG-ROLE-002",
        "A11-NG-ROLE-003"
      ],
      "status": "normative",
      "summary": "Actual inputs are not matched to roles by order; every required named role must be associated exactly once."
    },
    {

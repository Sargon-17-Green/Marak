      "spec_ids": [
        "A-ACT-021",
        "A-ACT-023",
        "A-ACT-024"
      ],
      "status": "normative",
      "summary": "Reusable described computation is named as מעשה; introduction uses יהי מעשה ושמו NAME and reference uses המעשה אשר שמו NAME."
    },
    {
      "construction_id": "A10.NAMED_ACT_PERFORMANCE",
      "kind": "positive",
      "spec_ids": [
        "A-ACT-026"
      ],
      "status": "normative",
      "summary": "Explicit performance is עשה את המעשה אשר שמו NAME; a bare name is never invocation."
    },
    {
      "construction_id": "A10.NAMED_PLACE_STATE",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-001",
        "A-STATE-002",
        "A-STATE-006"
      ],
      "status": "normative",
      "summary": "מקום is a source-semantic changeable-state holder, distinct from its current numeric occupant and from implementation memory."
    },
    {
      "construction_id": "A10.NO_BARE_UNTIL_RECURRENCE",
      "kind": "negative",
      "spec_ids": [
        "A-REP-009",
        "A-REP-013"
      ],
      "status": "normative",
      "summary": "ACTION עד אשר P and ACTION וכן עשה עד אשר P are not the canonical Core recurrence; the admitted form contains וכן תעשה."
    },
    {
      "construction_id": "A10.NO_MITZVAH_CORE_CALL",
      "kind": "negative",
      "spec_ids": [
        "A-ACT-022"
      ],
      "status": "normative",
      "summary": "מצוה is superseded as the primary Core reusable-computation abstraction; C must not preserve A8 syntax for compatibility."
    },
    {
      "construction_id": "A10.PLACE_INTRODUCTION",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-003"
      ],
      "status": "normative",
      "summary": "Initialized place introduction explicitly names the place and states its sole current numeric occupant."
    },
    {
      "construction_id": "A10.PLACE_REPLACEMENT",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-004",
        "A-STATE-005"
      ],
      "status": "normative",
      "summary": "Replacement explicitly names destination, new occupant, and displaced current numeric occupant."
    },
    {
      "construction_id": "A11.CURRENT_PERFORMANCE",
      "kind": "positive",
      "spec_ids": [
        "A-CURRENT-001",
        "A-CURRENT-002",
        "A-CURRENT-003"
      ],
      "status": "normative",
      "summary": "המעשה הזה is the current performance occurrence only inside an act body; it is a source deictic, not a stack-frame lookup rule."
    },
    {
      "construction_id": "A11.INPUT_ROLE",
      "kind": "positive",
      "spec_ids": [
        "A-ROLE-001",
        "A-ROLE-002",
        "A-ROLE-005",
        "A-ROLE-006"
      ],
      "status": "normative",
      "summary": "A numeric input role is a named דבר owned by a named מעשה; role identity is explicit and never positional."
    },
    {
      "construction_id": "A11.NO_FREE_RESULT_HISTORY",
      "kind": "negative",
      "spec_ids": [
        "A11-NG-OUT-003",
        "A11-NG-OUT-004"
      ],
      "status": "normative",
      "summary": "A result reference is immediate and uniquely determined; there is no hidden global last-result register or historical nearest-result lookup."
    },
    {
      "construction_id": "A11.NO_IMPLICIT_RETURN",

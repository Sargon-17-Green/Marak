      "spec_ids": [
        "A-ROLE-003",
        "A-ROLE-004"
      ],
      "status": "normative",
      "summary": "Performance associates a pure numeric Value with an explicitly named role via בהיות VALUE תחת ROLE; source order does not establish matching."
    },
    {

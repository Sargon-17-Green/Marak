      "spec_ids": [
        "A11-NG-OUT-001",
        "A11-NG-OUT-002",
        "A11-NG-LEAK-003"
      ],
      "status": "normative",
      "summary": "A final value is not an implicit result and result production is not abrupt Return/tuple-return semantics."
    },
    {

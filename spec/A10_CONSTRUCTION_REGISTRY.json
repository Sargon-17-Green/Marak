{
  "declarations": [
    {
      "construction_id": "A10.AFTER_GATED_RECURRENCE",
      "kind": "positive",
      "spec_ids": [
        "A-REP-009",
        "A-REP-010",
        "A-REP-011",
        "A-REP-012",
        "A-REP-013"
      ],
      "status": "normative",
      "summary": "ATOMIC_ACTION וכן תעשה עד אשר P performs the action once, then checks P after each occurrence and repeats the same atomic act until P holds."
    },
    {
      "construction_id": "A10.NAMED_ACT_IDENTITY",
      "kind": "positive",
      "spec_ids": [
        "A-ACT-021",
        "A-ACT-023",
        "A-ACT-024"
      ],
      "status": "normative",
      "summary": "Reusable described computation is named as מעשה; introduction uses יהי מעשה ושמו NAME and reference uses המעשה אשר שמו NAME."
    },
    {
      "construction_id": "A10.NAMED_ACT_PERFORMANCE",
      "kind": "positive",
      "spec_ids": [
        "A-ACT-026"
      ],
      "status": "normative",
      "summary": "Explicit performance is עשה את המעשה אשר שמו NAME; a bare name is never invocation."
    },
    {
      "construction_id": "A10.NAMED_PLACE_STATE",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-001",
        "A-STATE-002",
        "A-STATE-006"
      ],
      "status": "normative",
      "summary": "מקום is a source-semantic changeable-state holder, distinct from its current numeric occupant and from implementation memory."
    },
    {
      "construction_id": "A10.NO_BARE_UNTIL_RECURRENCE",
      "kind": "negative",
      "spec_ids": [
        "A-REP-009",
        "A-REP-013"
      ],
      "status": "normative",
      "summary": "ACTION עד אשר P and ACTION וכן עשה עד אשר P are not the canonical Core recurrence; the admitted form contains וכן תעשה."
    },
    {
      "construction_id": "A10.NO_MITZVAH_CORE_CALL",
      "kind": "negative",
      "spec_ids": [
        "A-ACT-022"
      ],
      "status": "normative",
      "summary": "מצוה is superseded as the primary Core reusable-computation abstraction; C must not preserve A8 syntax for compatibility."
    },
    {
      "construction_id": "A10.PLACE_INTRODUCTION",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-003"
      ],
      "status": "normative",
      "summary": "Initialized place introduction explicitly names the place and states its sole current numeric occupant."
    },
    {
      "construction_id": "A10.PLACE_REPLACEMENT",
      "kind": "positive",
      "spec_ids": [
        "A-STATE-004",
        "A-STATE-005"
      ],
      "status": "normative",
      "summary": "Replacement explicitly names destination, new occupant, and displaced current numeric occupant."
    },
    {
      "construction_id": "A10.RESULT_PROVENANCE_NUMBER",
      "kind": "positive",
      "spec_ids": [
        "A-RESULT-006",
        "A-RESULT-007",
        "A-RESULT-008"
      ],
      "status": "normative",
      "summary": "A numeric result is identified by provenance המספר אשר יצא מן המעשה אשר שמו NAME; production and cessation are separate."
    },
    {
      "construction_id": "A9.COUNTED_RECURRENCE",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-009"
      ],
      "status": "normative",
      "summary": "Exact N פעמים recurrence is admitted only for counts whose morphology and repeated material are structurally closed."
    },
    {
      "construction_id": "A9.EXPLICIT_SEQUENCE",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-005"
      ],
      "status": "normative",
      "summary": "Where order matters, the retained overt temporal relation is ואחרי כן; source order and bare waw do not create sequence."
    },
    {
      "construction_id": "A9.NO_HIDDEN_DEREFERENCE",
      "kind": "negative",
      "spec_ids": [
        "A-CORE-002",
        "A9-STABLE-NEGATIVE"
      ],
      "status": "normative",
      "summary": "A referent is not silently replaced by its current content merely because an implementation stores content in a cell."
    },
    {
      "construction_id": "A9.NO_POSITIONAL_INPUT_CONVENTION",
      "kind": "negative",
      "spec_ids": [
        "A9-STABLE-NEGATIVE"
      ],
      "status": "normative",
      "summary": "Positional argument matching is unavailable unless linguistic role marking later licenses it."
    },
    {
      "construction_id": "A9.NUMERIC_IDENTITY",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-006"
      ],
      "status": "normative",
      "summary": "VALUE_A הוא VALUE_B is the retained exact numeric identity proposition in the controlled numeric frame."
    },
    {
      "construction_id": "A9.NUMERIC_LITERAL_FRAME",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-006",
        "A-CORE-007"
      ],
      "status": "normative",
      "summary": "Numeric values may be denoted by המספר אשר הוא NUMERAL. C currently encodes only the proved אחד atom while the productive magnitude grammar beyond the former finite fixture ceiling remains open."
    },
    {
      "construction_id": "A9.PAIRED_CONDITIONAL",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-008"
      ],
      "status": "normative",
      "summary": "Conditional consequence uses the paired Hebrew shell אם P A ואם לא B; no dangling-else convention is available."
    },
    {
      "construction_id": "A9.PURE_ADDITION_FRAME",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-006"
      ],
      "status": "normative",
      "summary": "Pure addition uses the explicit Biblical-Hebrew valency frame המספר הנחשב בהוסיף את A על B."
    },
    {
      "construction_id": "A9.PURE_SUBTRACTION_FRAME",
      "kind": "positive",
      "spec_ids": [
        "A-CORE-006"
      ],
      "status": "normative",
      "summary": "Pure subtraction uses the explicit Biblical-Hebrew valency frame המספר הנחשב בגרע את A מן B."
    },
    {
      "construction_id": "A9.UNTIL_NOT_GENERIC_LOOP",
      "kind": "negative",
      "spec_ids": [
        "A-CORE-010"
      ],
      "status": "normative",
      "summary": "Bare עד אשר does not select a conventional pre-test or post-test recurrence model."
    }
  ],
